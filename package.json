{
  "name": "baton",
  "version": "0.1.0",
  "description": "One terminal CLI for every coding agent harness. Same thread, any model, native prompt caching.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "baton": "bin/baton.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "ink": "^6.2.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
